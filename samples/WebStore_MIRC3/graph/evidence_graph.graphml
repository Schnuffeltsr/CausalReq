</node>
<node id="Validate Changes">
  <data key="d0">CONSTRAINT</data>
  <data key="d1">0.9</data>
  <data key="d2">the system has validated the changes to contact information</data>
</node>
<node id="Order Cancellation">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.96</data>
  <data key="d2">the order cancellation function is executed for a selected order</data>
</node>
<node id="Eligible Order Status">
  <data key="d0">STATE</data>
  <data key="d1">0.95</data>
  <data key="d2">the selected order is in an eligible status for cancellation</data>
</node>
<node id="Cancelled Order Status">
  <data key="d0">STATE</data>
  <data key="d1">0.97</data>
  <data key="d2">the order is marked as Cancelled in the Order data entity</data>
</node>
<node id="Cancellation Event Recorded">
  <data key="d0">EVENT</data>
  <data key="d1">0.97</data>
