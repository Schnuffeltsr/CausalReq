  <data key="d1">0.95</data>
  <data key="d2">the viewing event for the email record has been logged/recorded in Purchase History</data>
</node>
<node id="View CartItem Function">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.95</data>
  <data key="d2">the customer is using the View CartItem function to view details of a specific cart item</data>
</node>
<node id="Cart Item Details Displayed">
  <data key="d0">STATE</data>
  <data key="d1">0.9</data>
  <data key="d2">the system is displaying the product description, price, and quantity of the specific cart item to the customer</data>
</node>
<node id="View Payment Function">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.95</data>
  <data key="d2">the payment details are displayed by the system to the customer or administrator</data>
</node>
<node id="Payment Viewing Event">
  <data key="d0">EVENT</data>
  <data key="d1">0.95</data>
  <data key="d2">the viewing event has been recorded in the Purchase History data entity</data>
</node>
<node id="Manage Administrator Function">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.95</data>
  <data key="d2">an administrator manages another administrator account by updating or deactivating it</data>
</node>
<node id="Management Event">
  <data key="d0">EVENT</data>
  <data key="d1">0.9</data>
  <data key="d2"></data>
</node>
<node id="Manage Customer Function">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.95</data>
  <data key="d2">the manage customer function is executed to update or deactivate a customer account</data>
</node>
<node id="Manage Category Function">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.96</data>
  <data key="d2">the manage category function is being executed by an administrator</data>
</node>
<node id="Validate Category">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.88</data>
  <data key="d2">the system is validating the category during the manage category function</data>
</node>
<node id="Product Associations">
  <data key="d0">DATA</data>
  <data key="d1">0.85</data>
  <data key="d2">product associations have been modified accordingly</data>
</node>
<node id="Manage User Interface Specification Function">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.95</data>
  <data key="d2">the system is executing the function that modifies the User Interface Specification based on administrator input</data>
</node>
<node id="User Interface Specification data entity">
  <data key="d0">DATA</data>
  <data key="d1">0.95</data>
  <data key="d2">the User Interface Specification data entity has been updated with the latest specification details</data>
</node>
<node id="System Interface Modified">
  <data key="d0">STATE</data>
  <data key="d1">0.9</data>
  <data key="d2">the system interface reflects the modified User Interface Specification</data>
</node>
<node id="Management Event Recorded">
  <data key="d0">EVENT</data>
  <data key="d1">0.94</data>
  <data key="d2">the management event for the User Interface Specification change has been recorded in the Purchase History data entity</data>
</node>
<node id="Manage Personal Information">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.95</data>
  <data key="d2">the system provides customers or administrators the ability to view or update a customer's personal information</data>
</node>
<node id="Personal Information Data Entity">
  <data key="d0">DATA</data>
  <data key="d1">0.9</data>
  <data key="d2">the personal information data entity has been updated with validated changes</data>
</node>
<node id="Validate Personal Information Changes">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.9</data>
  <data key="d2">the system has successfully validated the personal information changes before updating the data entity</data>
</node>
<node id="Personal Information View or Update Event">
  <data key="d0">EVENT</data>
  <data key="d1">0.9</data>
  <data key="d2">a customer or administrator has viewed or updated personal information and the event has been recorded in Purchase History</data>
</node>
<node id="Viewing or Update Event">
  <data key="d0">EVENT</data>
  <data key="d1">0.9</data>
