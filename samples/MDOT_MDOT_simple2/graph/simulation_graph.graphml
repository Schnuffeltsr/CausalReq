</node>
<node id="Support batch ingestion of historical data">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.95</data>
  <data key="d2">the system is actively supporting batch ingestion of historical data for backfilling archives and training models</data>
</node>
<node id="Compute traffic metrics">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.98</data>
  <data key="d2">The system has computed traffic metrics including congestion levels, travel times, queue lengths, and traffic flow patterns.</data>
</node>
<node id="Detect and classify incidents">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.98</data>
  <data key="d2">The system has detected and classified at least one incident as a crash, debris, stalled vehicle, or work zone.</data>
</node>
<node id="Calculate road surface conditions">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.98</data>
  <data key="d2">The system has calculated road surface conditions using weather data and sensor inputs.</data>
</node>
<node id="Perform automated data quality checks">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.98</data>
  <data key="d2">The system has performed automated data quality checks and flagged anomalies and inconsistencies.</data>
</node>
<node id="Support machine learning models">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.98</data>
  <data key="d2">The system is supporting machine learning models for predictive analysis of traffic trends and incident likelihood.</data>
</node>
<node id="Generate statistical summaries">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.98</data>
