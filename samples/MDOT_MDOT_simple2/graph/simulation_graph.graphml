<graph edgedefault="directed"><node id="Accept real-time data inputs from external sources">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.97</data>
  <data key="d2">the system is actively accepting real-time data inputs from probe vehicles, traffic sensors, weather stations, and traveler information systems</data>
</node>
<node id="Input data fields">
  <data key="d0">DATA</data>
  <data key="d1">0.93</data>
  <data key="d2">the listed data fields are present in the incoming real-time data stream and accepted by the system for processing</data>
</node>
<node id="Normalized data stored in central database">
  <data key="d0">STATE</data>
  <data key="d1">0.95</data>
  <data key="d2">normalized data has been successfully stored in the central database and is available as output</data>
</node>
<node id="Validate incoming data and reject invalid data">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.96</data>
  <data key="d2">the validation process is active: incoming data is being checked against predefined quality rules and invalid or malformed records are rejected</data>
</node>
<node id="Predefined quality rules">
  <data key="d0">CONSTRAINT</data>
  <data key="d1">0.92</data>
  <data key="d2">the constraint that incoming data must conform to predefined quality rules is enforced; nonconforming data is rejected</data>
</node>
<node id="Configure new data source types without major software changes">
  <data key="d0">FUNCTION</data>
  <data key="d1">0.94</data>
