# credentials and local configuration
.env
*.key
credentials.yaml

# LLM screening cache (scheduling artefact, regenerated per run)
samples/*/cache/
**/cache/validation/

# local figure output (the released scripts do not write figures)
figures/

# local experiment run roots (an out-root other than samples/ stays untracked)
gpt_run/
runs/

# optional local inventory file
MANIFEST.md

# python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
venv/
.venv/

# run logs (per-call traces, several MB each)
*.log
*.err

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
